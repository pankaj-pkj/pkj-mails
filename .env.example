# =====================================================================
#  PKJ Mails settings
#  1. Copy this file and name the copy ".env"  (just ".env", nothing before the dot)
#  2. Fill the values marked REQUIRED. Everything else can stay as it is.
#  3. Never share your .env file or upload it anywhere. It holds your secrets.
# =====================================================================

# REQUIRED: a long random secret (at least 32 characters). It protects logins and
# your saved mail passwords. Make one with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Which database to use. Pick ONE:  sqlite  |  mongodb  |  postgres  |  mysql  |  firebase
# sqlite needs no setup at all (a file in the data folder). Start with it.
DB_TYPE=sqlite

# Only for DB_TYPE=sqlite: where the database file lives.
SQLITE_FILE=./data/pkj-mails.db

# Only for mongodb / postgres / mysql: the connection link your database provider gives you.
#   mongodb:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/pkjmails
#   postgres: postgres://user:password@host:5432/pkjmails
#   mysql:    mysql://user:password@host:3306/pkjmails
DATABASE_URL=

# Only for DB_TYPE=firebase (Realtime Database).
#   FIREBASE_DB_URL     like https://your-project-default-rtdb.firebaseio.com
#   FIREBASE_DB_SECRET  Project settings > Service accounts > Database secrets
FIREBASE_DB_URL=
FIREBASE_DB_SECRET=

# The web port. Hosting sites like Render set this for you.
PORT=3000

# ---------------------------------------------------------------------
#  OPTIONAL. You can leave all of these empty and fill them on the
#  setup page in the app instead. Values here win over the setup page.
# ---------------------------------------------------------------------

# A fixed code for the first-run setup page. If empty, a code is printed in the server log at start.
SETUP_CODE=

# Admin login (if set here, the setup page skips this step)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sending mail (SMTP). Examples:
#   Gmail:  smtp.gmail.com  port 465  SMTP_SECURE=true   user = your Gmail, pass = a Gmail "App password"
#   Brevo:  smtp-relay.brevo.com  port 587  SMTP_SECURE=false
#   Resend: smtp.resend.com  port 465  SMTP_SECURE=true  user = resend
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=

# Receiving mail by IMAP (checks a mailbox every IMAP_POLL_SECONDS)
#   Gmail: imap.gmail.com  port 993
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60

# Receiving mail by webhook (POST /api/inbound). Any long random text.
INBOUND_SECRET=

# Set to 1 when the app runs behind a proxy (Render, Nginx, Cloudflare) so rate limits see real visitor IPs.
TRUST_PROXY=1
